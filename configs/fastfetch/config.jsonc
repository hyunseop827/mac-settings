{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "size": {
      "maxPrefix": "GB",
      "ndigits": 1,
      "spaceBeforeUnit": "always"
    },
    "freq": {
      "ndigits": 1,
      "spaceBeforeUnit": "always"
    }
  },
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": "󰀵 OS" },
    { "type": "host", "key": "󰌢 Host" },
    { "type": "kernel", "key": "󰌽 Kernel", "format": "{release}" },
    { "type": "uptime", "key": "󰔚 Uptime" },
    { "type": "packages", "key": "󰏗 Packages", "combined": true },
    { "type": "shell", "key": "󰆍 Shell" },
    { "type": "display", "key": "󰍹 Display", "compactType": "original" },
    { "type": "wm", "key": "󰖲 WM" },
    { "type": "theme", "key": "󰉼 Theme" },
    { "type": "terminal", "key": " Terminal" },
    {
      "type": "terminalfont",
      "key": " Font",
      "format": "JetBrainsMonoNL Nerd Font Mono 14 + Apple SD Gothic Neo"
    },
    { "type": "cpu", "key": "󰍛 CPU" },
    { "type": "gpu", "key": "󰢮 GPU", "format": "{name}" },
    { "type": "memory", "key": "󰘚 Memory", "format": "{used} / {total}" },
    { "type": "disk", "key": "󰋊 Disk", "folders": "/" },
    { "type": "battery", "key": "󰁹 Battery" },
    { "type": "locale", "key": "󰗊 Locale" },
    "break",
    "colors"
  ]
}
